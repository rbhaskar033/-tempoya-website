rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(userId) { return signedIn() && request.auth.uid == userId; }
    function isBlockedBetween(userA, userB) {
      return exists(/databases/$(database)/documents/blocks/$(userA + '_' + userB))
        || exists(/databases/$(database)/documents/blocks/$(userB + '_' + userA));
    }
    function isMatchMember(matchId) {
      return signedIn()
        && exists(/databases/$(database)/documents/matches/$(matchId))
        && request.auth.uid in get(/databases/$(database)/documents/matches/$(matchId)).data.members
        && !isBlockedBetween(
          get(/databases/$(database)/documents/matches/$(matchId)).data.members[0],
          get(/databases/$(database)/documents/matches/$(matchId)).data.members[1]
        );
    }

    match /users/{userId} {
      allow read: if owner(userId);
      allow create: if owner(userId)
        && !request.resource.data.keys().hasAny(['verificationFeePaid','verificationFeePaidAt','verificationFeeCountry','verificationFeeCurrency','verificationStatus'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 60
        && request.resource.data.age is int
        && request.resource.data.age >= 18
        && request.resource.data.age <= 120
        && request.resource.data.country is string
        && request.resource.data.preferredLanguage is string
        && request.resource.data.gender is string
        && request.resource.data.gender in ['woman','man','non_binary','self_described'];
      allow update: if owner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['verificationFeePaid','verificationFeePaidAt','verificationFeeCountry','verificationFeeCurrency','verificationStatus'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 60
        && request.resource.data.age is int
        && request.resource.data.age >= 18
        && request.resource.data.age <= 120
        && request.resource.data.country is string
        && request.resource.data.preferredLanguage is string;
      allow delete: if owner(userId);
    }

    // Public discovery records expose only a limited profile; the client must never write phone numbers here.
    match /publicProfiles/{userId} {
      // Owners can read their own profile. Other users must be signed in,
      // have an existing adult account, and the owner must have published the profile.
      allow read: if owner(userId)
        || (signedIn()
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.age is int
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.age >= 18
          && resource.data.discoverable == true);
      allow create, update: if owner(userId)
        && request.resource.data.keys().hasOnly(['displayName','age','gender','country','preferredLanguage','bio','discoverable','updatedAt'])
        && request.resource.data.displayName is string
        && request.resource.data.age is int
        && request.resource.data.age >= 18
        && request.resource.data.gender is string
        && request.resource.data.gender in ['woman','man','non_binary','self_described']
        && request.resource.data.country is string
        && request.resource.data.preferredLanguage is string
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 240
        && request.resource.data.discoverable is bool;
      allow delete: if owner(userId);
    }

    match /likes/{likeId} {
      allow read: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid
        && likeId == request.auth.uid + '_' + request.resource.data.to;
      allow update, delete: if false;
    }

    match /matches/{matchId} {
      allow read: if signedIn()
        && request.auth.uid in resource.data.members
        && !isBlockedBetween(resource.data.members[0], resource.data.members[1]);
      allow create: if signedIn()
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.resource.data.members[0] is string
        && request.resource.data.members[1] is string
        && request.resource.data.members[0] < request.resource.data.members[1]
        && request.auth.uid in request.resource.data.members
        && !isBlockedBetween(request.resource.data.members[0], request.resource.data.members[1])
        && matchId == request.resource.data.members[0] + '_' + request.resource.data.members[1]
        && exists(/databases/$(database)/documents/likes/$(request.resource.data.members[0] + '_' + request.resource.data.members[1]))
        && exists(/databases/$(database)/documents/likes/$(request.resource.data.members[1] + '_' + request.resource.data.members[0]))
        && get(/databases/$(database)/documents/likes/$(request.resource.data.members[0] + '_' + request.resource.data.members[1])).data.from == request.resource.data.members[0]
        && get(/databases/$(database)/documents/likes/$(request.resource.data.members[0] + '_' + request.resource.data.members[1])).data.to == request.resource.data.members[1]
        && get(/databases/$(database)/documents/likes/$(request.resource.data.members[1] + '_' + request.resource.data.members[0])).data.from == request.resource.data.members[1]
        && get(/databases/$(database)/documents/likes/$(request.resource.data.members[1] + '_' + request.resource.data.members[0])).data.to == request.resource.data.members[0];
      allow update: if signedIn() && request.auth.uid in resource.data.members
        && !isBlockedBetween(resource.data.members[0], resource.data.members[1])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessageAt']);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isMatchMember(matchId);
        allow create: if isMatchMember(matchId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 10000
          && request.resource.data.editCount == 0
          && (!request.resource.data.keys().hasAny(['type'])
            || request.resource.data.type != 'photos'
            || (request.resource.data.photoPaths is list
              && request.resource.data.photoPaths.size() >= 1
              && request.resource.data.photoPaths.size() <= 10));
        // A sender may edit only the text and edit metadata. Deletion is never allowed.
        // Each edit must atomically create an append-only audit record.
        allow update: if isMatchMember(matchId)
          && resource.data.senderId == request.auth.uid
          && request.resource.data.senderId == resource.data.senderId
          && resource.data.type != 'photos'
          && request.time < resource.data.createdAt + duration.value(1, 'h')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text','editedAt','editCount','lastEditId'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 10000
          && request.resource.data.editCount == (resource.data.keys().hasAny(['editCount']) ? resource.data.editCount + 1 : 1)
          && request.resource.data.lastEditId is string
          && existsAfter(/databases/$(database)/documents/matches/$(matchId)/messages/$(messageId)/edits/$(request.resource.data.lastEditId))
          && getAfter(/databases/$(database)/documents/matches/$(matchId)/messages/$(messageId)/edits/$(request.resource.data.lastEditId)).data.editorId == request.auth.uid
          && getAfter(/databases/$(database)/documents/matches/$(matchId)/messages/$(messageId)/edits/$(request.resource.data.lastEditId)).data.oldText == resource.data.text
          && getAfter(/databases/$(database)/documents/matches/$(matchId)/messages/$(messageId)/edits/$(request.resource.data.lastEditId)).data.newText == request.resource.data.text;
        allow delete: if false;

        match /edits/{editId} {
          allow read: if isMatchMember(matchId);
          allow create: if isMatchMember(matchId)
            && request.resource.data.keys().hasOnly(['editorId','oldText','newText','createdAt'])
            && request.resource.data.editorId == request.auth.uid
            && get(/databases/$(database)/documents/matches/$(matchId)/messages/$(messageId)).data.senderId == request.auth.uid
            && request.resource.data.oldText == get(/databases/$(database)/documents/matches/$(matchId)/messages/$(messageId)).data.text
            && request.resource.data.newText is string
            && request.resource.data.newText.size() > 0
            && request.resource.data.newText.size() <= 10000;
          allow update, delete: if false;
        }
      }
    }

    match /bookings/{bookingId} {
      allow read: if signedIn()
        && request.auth.uid in resource.data.members
        && isMatchMember(resource.data.matchId);
      allow create: if signedIn()
        && request.auth.uid == request.resource.data.requesterId
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && request.resource.data.matchId is string
        && isMatchMember(request.resource.data.matchId)
        && get(/databases/$(database)/documents/matches/$(request.resource.data.matchId)).data.members == request.resource.data.members
        && request.resource.data.venue is string
        && request.resource.data.venue.size() >= 3
        && request.resource.data.venue.size() <= 160
        && request.resource.data.meetingTime is timestamp
        && request.resource.data.meetingTime > request.time
        && request.resource.data.durationMinutes in [15,30,60,120,180]
        && request.resource.data.status == 'requested'
        && request.resource.data.paymentStatus == 'not_enabled';
      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && request.auth.uid != resource.data.requesterId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
        && resource.data.status == 'requested'
        && request.resource.data.status in ['accepted','declined']
        && request.resource.data.requesterId == resource.data.requesterId
        && request.resource.data.members == resource.data.members
        && request.resource.data.matchId == resource.data.matchId
        && request.resource.data.paymentStatus == resource.data.paymentStatus
        && isMatchMember(resource.data.matchId);
      allow delete: if false;
    }

    // Payment records and verification flags are server-controlled only.
    match /verificationPayments/{userId} {
      allow read, write: if false;
    }

    match /blocks/{blockId} {
      allow read: if signedIn() && resource.data.by == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.by == request.auth.uid
        && request.resource.data.blocked is string
        && request.resource.data.blocked != request.auth.uid
        && blockId == request.resource.data.by + '_' + request.resource.data.blocked
        && request.resource.data.keys().hasOnly(['by','blocked','createdAt']);
      allow update, delete: if false;
    }

    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.by == request.auth.uid
        && request.resource.data.reported is string
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 500;
      allow read: if false;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}